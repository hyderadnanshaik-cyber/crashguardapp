# ============================================================
# Crash Guard Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend origin (for CORS whitelist) ────────────────────
FRONTEND_ORIGIN=http://localhost:5174

# ── Firebase Admin SDK ──────────────────────────────────────
# Paste the ENTIRE JSON content of your service account key
# (from Firebase Console → Project Settings → Service Accounts
#  → Generate new private key) as a single-line JSON string.
# Example: FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase project ID (must match your Firestore project)
FIREBASE_PROJECT_ID=crashguard-demo

# ── SendGrid ────────────────────────────────────────────────
SENDGRID_API_KEY=SG.placeholder_replace_with_real_key
SENDGRID_FROM_EMAIL=alerts@crashguard.ai
SENDGRID_FROM_NAME=Crash Guard Emergency System

# ── Google Places API ───────────────────────────────────────
GOOGLE_PLACES_API_KEY=placeholder_replace_with_real_key

# ── App ─────────────────────────────────────────────────────
# Base URL of the relative tracking portal (used in email links)
APP_BASE_URL=http://localhost:5174
